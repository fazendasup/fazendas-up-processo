# ============================================================
# Fazendas Up — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database Connection
# Examples:
#   MySQL:      mysql://user:password@localhost:3306/fazendas_up
#   PostgreSQL: postgresql://user:password@localhost:5432/fazendas_up
#   SQLite:     file:./fazendas_up.db
DATABASE_URL=mysql://user:password@localhost:3306/fazendas_up

# JWT Secret for session cookie signing
# Generate a strong random string (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node Environment
# Options: development, production
NODE_ENV=development

# Server Port (optional, defaults to 3456 in this repo)
# PORT=3456

# Central Comercial (módulo integrado em /comercial)
# Local: use base separada (docker compose porta 3307). Railway: omita — usa DATABASE_URL + fazendas_comercial auto.
# COMERCIAL_DATABASE_URL=mysql://user:password@localhost:3307/fazendas_comercial
# COMERCIAL_USE_ERP_DATABASE=1
# CONTA_AZUL_CLIENT_ID=
# CONTA_AZUL_CLIENT_SECRET=
# CONTA_AZUL_REDIRECT_URI=http://localhost:3456/integrations/conta-azul/callback
# ENABLE_COMERCIAL_INTEGRATION_CRON=true
