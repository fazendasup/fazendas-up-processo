generator client {
  provider      = "prisma-client-js"
  output        = "../server/comercial/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("COMERCIAL_DATABASE_URL")
}

enum PerfilUsuario {
  VENDEDOR
  PROMOTER
  LIDER_COLHEITA
  GERENTE_COMERCIAL
  COMERCIAL
  OPERACOES
  LOGISTICA
  ADMIN
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

enum TipoCliente {
  RESTAURANTE
  PLANO_ASSINATURA
  SUPERMERCADO
  AVULSO
  OUTROS
}

enum StatusRelacionamento {
  ATIVO
  INATIVO
  EM_RISCO
  ESTRATEGICO
}

enum OrigemPedido {
  CONTA_AZUL
  MANUAL
}

enum TipoInteracao {
  WHATSAPP
  EMAIL
  LIGACAO
  PRESENCIAL
}

enum TipoOportunidade {
  UPSELL
  CROSS_SELL
  REATIVACAO
  NOVO_PRODUTO
}

enum PrioridadeOportunidade {
  ALTA
  MEDIA
  BAIXA
}

enum StatusOportunidade {
  ABERTA
  EM_CONTATO
  CONVERTIDA
  PERDIDA
}

enum TipoMensagem {
  POS_VENDA
  OFERTA
  REATIVACAO
  INFORMATIVO
}

enum StatusEnvioMensagem {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  ENVIADA
  FALHA
}

enum AcaoApi {
  SYNC_CA
  ENVIO_MC
  ANALISE_IG
  PESQUISA_WEB
}

enum StatusExecucaoApi {
  SUCESSO
  FALHA
  PENDENTE
}

enum PeriodoKpi {
  DIARIO
  SEMANAL
  MENSAL
}

enum PedidoOperacionalStatus {
  PENDENTE
  PRONTO
  ENTREGUE
  CANCELADO
}

enum RotaEntregaStatus {
  PLANEJADA
  EM_ROTA
  CONCLUIDA
  CANCELADA
}

enum ParadaEntregaStatus {
  PENDENTE
  EM_ROTA
  ENTREGUE
  PROBLEMA
  PULADA
}

enum StatusConciliacaoOperacional {
  PLANEJADO
  VINCULO_SUGERIDO
  CONCILIADO
  DIVERGENTE
  VENDA_ERRADA
}

enum StatusConciliacaoContaAzul {
  NAO_CONCILIADA
  SUGERIDA
  CONCILIADA
  DIVERGENTE
  IGNORADA
  VENDA_ERRADA
}

enum TipoVendaPedido {
  RECORRENTE_SEMANAL
  RECORRENTE_QUINZENAL
  PLANO
  AVULSO
}

enum PeriodoEntregaCliente {
  MANHA
  TARDE
}

enum ModoCompraProduto {
  UNIDADE
  KG
}

model Usuario {
  id               String                       @id @default(cuid())
  nome             String
  email            String                       @unique
  senhaHash        String                       @map("senha_hash")
  perfil           PerfilUsuario
  status           StatusUsuario                @default(ATIVO)
  dataCadastro     DateTime                     @default(now()) @map("data_cadastro")
  mensagens        Mensagem[]                   @relation("MensagemAprovador")
  refreshTokens    RefreshToken[]
  oportunidades    Oportunidade[]
  pedidosCriados   PedidoOperacional[]          @relation("PedidoCriadoPor")
  pedidosEditados  PedidoOperacional[]          @relation("PedidoEditadoPor")
  avariasCriadas   PedidoOperacionalAvaria[]    @relation("AvariaCriadaPor")
  auditoriasPedido PedidoOperacionalAuditoria[]
  rotasEntrega     RotaEntrega[]                @relation("RotaEntregaEntregador")
  rotasCriadas     RotaEntrega[]                @relation("RotaEntregaCriadaPor")
  rotasAtualizadas RotaEntrega[]                @relation("RotaEntregaAtualizadaPor")

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String    @map("usuario_id")
  tokenHash  String    @map("token_hash")
  expiresEm  DateTime  @map("expires_em")
  revogadoEm DateTime? @map("revogado_em")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

/// Rede / grupo que agrupa Clientes-unidade (ex.: uma rede de supermercados com várias lojas).
model GrupoCliente {
  id           String       @id @default(cuid())
  nome         String
  tipo         TipoCliente?
  observacoes  String?      @db.Text
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  clientes Cliente[]

  @@index([nome])
  @@map("grupos_cliente")
}

model Cliente {
  id                    String               @id @default(cuid())
  externalId            String?              @unique @map("external_id")
  nome                  String
  tipo                  TipoCliente
  grupoId               String?              @map("grupo_id")
  cnpjCpf               String?              @map("cnpj_cpf")
  endereco              String?
  contatoPrincipal      String?              @map("contato_principal")
  emailPrincipal        String?              @map("email_principal")
  telefoneWhatsapp      String?              @map("telefone_whatsapp")
  scoreComercial        Decimal?             @map("score_comercial") @db.Decimal(5, 2)
  statusRelacionamento  StatusRelacionamento @map("status_relacionamento")
  tags                  Json
  urlInstagram          String?              @map("url_instagram")
  urlSite               String?              @map("url_site")
  dataCadastro          DateTime             @default(now()) @map("data_cadastro")
  dataUltimaAtualizacao DateTime             @updatedAt @map("data_ultima_atualizacao")

  grupo                GrupoCliente?                @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  pedidos              Pedido[]
  interacoes           Interacao[]
  oportunidades        Oportunidade[]
  mensagens            Mensagem[]
  execucoes            ExecucaoApi[]
  regraComercial       RegraComercialCliente?
  pedidosOperacionais  PedidoOperacional[]
  avariasOperacionais  PedidoOperacionalAvaria[]
  linksLegadoContaAzul ClienteLegadoContaAzulLink[]
  paradasEntrega       ParadaEntrega[]

  @@index([tipo, statusRelacionamento])
  @@index([nome])
  @@index([grupoId])
  @@map("clientes")
}

/// Configuração global do mix folha leve (referência + variedades).
model EstoqueVivoConfig {
  id                String   @id @default("default")
  mixReferenciaNome String   @map("mix_referencia_nome")
  mixVariedades     Json     @map("mix_variedades")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  @@map("estoque_vivo_config")
}

model ProdutoComercial {
  id                     String            @id @default(cuid())
  nome                   String            @unique
  contaAzulProdutoId     String?           @unique @map("conta_azul_produto_id")
  sku                    String?
  statusContaAzul        String?           @map("status_conta_azul")
  sincronizadoEm         DateTime?         @map("sincronizado_em")
  importadoOperacao      Boolean           @default(false) @map("importado_operacao")
  precoBase              Decimal?          @map("preco_base") @db.Decimal(14, 2)
  categoria              String?
  ativo                  Boolean           @default(true)
  modoCompra             ModoCompraProduto @default(UNIDADE) @map("modo_compra")
  fatorCompraUnidade     Decimal?          @map("fator_compra_unidade") @db.Decimal(14, 4)
  rendimentoPorKg        Decimal?          @map("rendimento_por_kg") @db.Decimal(14, 4)
  ocultoListaCompra      Boolean           @default(false) @map("oculto_lista_compra")
  mixAtivo               Boolean           @default(false) @map("mix_ativo")
  mixFolhaLeve           Boolean           @default(false) @map("mix_folha_leve")
  mixProdutoReferenciaId String?           @map("mix_produto_referencia_id")
  mixVariedades          Json?             @map("mix_variedades")
  criadoEm               DateTime          @default(now()) @map("criado_em")
  atualizadoEm           DateTime          @updatedAt @map("atualizado_em")

  precosEspeciais      PrecoEspecialCliente[]
  itensPedido          PedidoOperacionalItem[]
  avariasPedido        PedidoOperacionalAvaria[]
  mixProdutoReferencia ProdutoComercial?         @relation("ProdutoMixReferencia", fields: [mixProdutoReferenciaId], references: [id], onDelete: SetNull)
  mixReferenciadoPor   ProdutoComercial[]        @relation("ProdutoMixReferencia")

  @@index([nome])
  @@index([categoria])
  @@index([sku])
  @@index([importadoOperacao, ativo])
  @@map("produtos_comerciais")
}

model RegraComercialCliente {
  id                       String                 @id @default(cuid())
  contaAzulCustomerId      String                 @unique @map("conta_azul_customer_id")
  observacoesGerais        String?                @map("observacoes_gerais") @db.Text
  periodoEntrega           PeriodoEntregaCliente? @map("periodo_entrega")
  horarioMaximoEntrega     String?                @map("horario_maximo_entrega")
  cobraTaxaEntrega         Boolean                @default(false) @map("cobra_taxa_entrega")
  valorTaxaEntrega         Decimal?               @map("valor_taxa_entrega") @db.Decimal(14, 2)
  prazoBoletoDias          Int?                   @map("prazo_boleto_dias")
  descontoBoletoPercentual Decimal?               @map("desconto_boleto_percentual") @db.Decimal(5, 2)
  acumulaPedidos           Boolean                @default(false) @map("acumula_pedidos")
  diasAcumulo              Int?                   @map("dias_acumulo")
  prazoBoletoAcumuloDias   Int?                   @map("prazo_boleto_acumulo_dias")
  criadoEm                 DateTime               @default(now()) @map("criado_em")
  atualizadoEm             DateTime               @updatedAt @map("atualizado_em")

  cliente         Cliente?               @relation(fields: [contaAzulCustomerId], references: [externalId], onDelete: Cascade)
  precosEspeciais PrecoEspecialCliente[]

  @@map("regras_comerciais_cliente")
}

model ClienteLegadoContaAzulLink {
  id                  String   @id @default(cuid())
  legacyClientId      String   @unique @map("legacy_client_id")
  legacyClientName    String   @map("legacy_client_name")
  contaAzulCustomerId String   @map("conta_azul_customer_id")
  clienteId           String?  @map("cliente_id")
  metodo              String
  confianca           Decimal  @db.Decimal(5, 2)
  revisado            Boolean  @default(false)
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([contaAzulCustomerId])
  @@index([clienteId])
  @@map("clientes_legado_conta_azul_links")
}

model PrecoEspecialCliente {
  id           String   @id @default(cuid())
  regraId      String   @map("regra_id")
  produtoId    String   @map("produto_id")
  preco        Decimal  @db.Decimal(14, 2)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  regra   RegraComercialCliente @relation(fields: [regraId], references: [id], onDelete: Cascade)
  produto ProdutoComercial      @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([regraId, produtoId])
  @@index([produtoId])
  @@map("precos_especiais_cliente")
}

model PedidoOperacional {
  id                        String                       @id @default(cuid())
  clienteId                 String?                      @map("cliente_id")
  contaAzulCustomerId       String                       @map("conta_azul_customer_id")
  dataEntrega               DateTime                     @map("data_entrega")
  diaSemana                 Int                          @map("dia_semana")
  tipoVenda                 TipoVendaPedido              @map("tipo_venda")
  status                    PedidoOperacionalStatus      @default(PENDENTE)
  statusConciliacao         StatusConciliacaoOperacional @default(PLANEJADO) @map("status_conciliacao")
  pedidoContaAzulId         String?                      @unique @map("pedido_conta_azul_id")
  sugestaoPedidoContaAzulId String?                      @map("sugestao_pedido_conta_azul_id")
  snapshotConciliacao       Json?                        @map("snapshot_conciliacao")
  observacoes               String?                      @db.Text
  freteCortesia             Boolean                      @default(false) @map("frete_cortesia")
  prioridadeEntrega         Int?                         @map("prioridade_entrega")
  criadoPorId               String?                      @map("criado_por_id")
  editadoPorId              String?                      @map("editado_por_id")
  criadoEm                  DateTime                     @default(now()) @map("criado_em")
  atualizadoEm              DateTime                     @updatedAt @map("atualizado_em")

  cliente            Cliente?                     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoPor          Usuario?                     @relation("PedidoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  editadoPor         Usuario?                     @relation("PedidoEditadoPor", fields: [editadoPorId], references: [id], onDelete: SetNull)
  pedidoContaAzul    Pedido?                      @relation("PedidoOperacionalVinculo", fields: [pedidoContaAzulId], references: [id], onDelete: SetNull)
  itens              PedidoOperacionalItem[]
  avarias            PedidoOperacionalAvaria[]
  auditoria          PedidoOperacionalAuditoria[]
  eventosConciliacao PedidoConciliacaoEvento[]

  @@index([contaAzulCustomerId, dataEntrega])
  @@index([clienteId, dataEntrega])
  @@index([dataEntrega, status])
  @@index([statusConciliacao])
  @@index([sugestaoPedidoContaAzulId])
  @@map("pedidos_operacionais")
}

model RotaEntrega {
  id                    String            @id @default(cuid())
  dataEntrega           DateTime          @map("data_entrega")
  nome                  String?
  status                RotaEntregaStatus @default(PLANEJADA)
  entregadorId          String?           @map("entregador_id")
  entregadorNome        String?           @map("entregador_nome")
  tokenPublico          String            @unique @map("token_publico")
  compartilhamentoAtivo Boolean           @default(false) @map("compartilhamento_ativo")
  iniciadoEm            DateTime?         @map("iniciado_em")
  encerradoEm           DateTime?         @map("encerrado_em")
  ultimaLatitude        Decimal?          @map("ultima_latitude") @db.Decimal(10, 7)
  ultimaLongitude       Decimal?          @map("ultima_longitude") @db.Decimal(10, 7)
  ultimaPrecisaoMetros  Decimal?          @map("ultima_precisao_metros") @db.Decimal(10, 2)
  ultimaLocalizacaoEm   DateTime?         @map("ultima_localizacao_em")
  criadoPorId           String?           @map("criado_por_id")
  atualizadoPorId       String?           @map("atualizado_por_id")
  criadoEm              DateTime          @default(now()) @map("criado_em")
  atualizadoEm          DateTime          @updatedAt @map("atualizado_em")

  entregador    Usuario?                      @relation("RotaEntregaEntregador", fields: [entregadorId], references: [id], onDelete: SetNull)
  criadoPor     Usuario?                      @relation("RotaEntregaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor Usuario?                      @relation("RotaEntregaAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  paradas       ParadaEntrega[]
  localizacoes  HistoricoLocalizacaoEntrega[]

  @@index([dataEntrega, status])
  @@index([entregadorId])
  @@map("rotas_entrega")
}

model ParadaEntrega {
  id                  String              @id @default(cuid())
  rotaId              String              @map("rota_id")
  contaAzulCustomerId String              @map("conta_azul_customer_id")
  clienteId           String?             @map("cliente_id")
  ordem               Int
  status              ParadaEntregaStatus @default(PENDENTE)
  tokenPublico        String              @unique @map("token_publico")
  observacoes         String?             @db.Text
  observacoesProblema String?             @map("observacoes_problema") @db.Text
  entregueEm          DateTime?           @map("entregue_em")
  problemaEm          DateTime?           @map("problema_em")
  criadoEm            DateTime            @default(now()) @map("criado_em")
  atualizadoEm        DateTime            @updatedAt @map("atualizado_em")

  rota    RotaEntrega @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  cliente Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@unique([rotaId, contaAzulCustomerId])
  @@index([rotaId, ordem])
  @@index([clienteId])
  @@map("paradas_entrega")
}

model HistoricoLocalizacaoEntrega {
  id             String   @id @default(cuid())
  rotaId         String   @map("rota_id")
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  precisaoMetros Decimal? @map("precisao_metros") @db.Decimal(10, 2)
  criadoEm       DateTime @default(now()) @map("criado_em")

  rota RotaEntrega @relation(fields: [rotaId], references: [id], onDelete: Cascade)

  @@index([rotaId, criadoEm])
  @@map("historico_localizacao_entrega")
}

model PedidoOperacionalItem {
  id            String   @id @default(cuid())
  pedidoId      String   @map("pedido_id")
  produtoId     String   @map("produto_id")
  produtoNome   String   @map("produto_nome")
  categoria     String?
  quantidade    Decimal  @db.Decimal(12, 3)
  precoUnit     Decimal? @map("preco_unit") @db.Decimal(14, 2)
  precoEspecial Boolean  @default(false) @map("preco_especial")
  observacoes   String?  @db.Text

  pedido  PedidoOperacional @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto ProdutoComercial  @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@index([produtoId])
  @@map("pedidos_operacionais_itens")
}

model PedidoOperacionalAvaria {
  id                  String   @id @default(cuid())
  pedidoId            String   @map("pedido_id")
  clienteId           String?  @map("cliente_id")
  contaAzulCustomerId String   @map("conta_azul_customer_id")
  dataEntrega         DateTime @map("data_entrega")
  produtoId           String   @map("produto_id")
  produtoNome         String   @map("produto_nome")
  categoria           String?
  quantidade          Decimal  @db.Decimal(12, 3)
  observacoes         String?  @db.Text
  criadoPorId         String?  @map("criado_por_id")
  criadoEm            DateTime @default(now()) @map("criado_em")

  pedido    PedidoOperacional @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente   Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  produto   ProdutoComercial  @relation(fields: [produtoId], references: [id])
  criadoPor Usuario?          @relation("AvariaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([pedidoId], map: "avarias_pedido_idx")
  @@index([contaAzulCustomerId, dataEntrega], map: "avarias_conta_data_idx")
  @@index([clienteId, dataEntrega], map: "avarias_cliente_data_idx")
  @@index([produtoId, dataEntrega], map: "avarias_produto_data_idx")
  @@map("pedidos_operacionais_avarias")
}

model PedidoOperacionalAuditoria {
  id          String   @id @default(cuid())
  pedidoId    String   @map("pedido_id")
  usuarioId   String?  @map("usuario_id")
  usuarioNome String?  @map("usuario_nome")
  acao        String
  antes       Json?
  depois      Json?
  criadoEm    DateTime @default(now()) @map("criado_em")

  pedido  PedidoOperacional @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId, criadoEm])
  @@map("pedidos_operacionais_auditoria")
}

/// Fechamento semanal global da operação de pedidos.
/// Trava a criação de pedidos de semanas seguintes enquanto a anterior não for revisada e fechada.
model FechamentoSemanal {
  id              String    @id @default(cuid())
  semanaInicio    DateTime  @unique @map("semana_inicio")
  semanaFim       DateTime  @map("semana_fim")
  fechadoPorId    String?   @map("fechado_por_id")
  fechadoPorNome  String?   @map("fechado_por_nome")
  fechadoEm       DateTime  @default(now()) @map("fechado_em")
  totalPedidos    Int       @default(0) @map("total_pedidos")
  totalEntregues  Int       @default(0) @map("total_entregues")
  totalCancelados Int       @default(0) @map("total_cancelados")
  valorEntregue   Decimal?  @map("valor_entregue") @db.Decimal(14, 2)
  reabertoEm      DateTime? @map("reaberto_em")
  reabertoPorId   String?   @map("reaberto_por_id")
  reabertoPorNome String?   @map("reaberto_por_nome")
  snapshot        Json?

  @@index([semanaInicio])
  @@map("fechamentos_semanais")
}

model Pedido {
  id                          String                     @id @default(cuid())
  externalId                  String?                    @unique @map("external_id")
  numeroVenda                 String?                    @map("numero_venda")
  clienteId                   String                     @map("cliente_id")
  dataPedido                  DateTime                   @map("data_pedido")
  valorTotal                  Decimal                    @map("valor_total") @db.Decimal(14, 2)
  valorBruto                  Decimal?                   @map("valor_bruto") @db.Decimal(14, 2)
  valorFrete                  Decimal                    @default(0) @map("valor_frete") @db.Decimal(14, 2)
  valorDesconto               Decimal                    @default(0) @map("valor_desconto") @db.Decimal(14, 2)
  valorLiquido                Decimal?                   @map("valor_liquido") @db.Decimal(14, 2)
  composicaoDetalhada         Boolean                    @default(false) @map("composicao_detalhada")
  statusPedido                String                     @map("status_pedido")
  statusConciliacao           StatusConciliacaoContaAzul @default(NAO_CONCILIADA) @map("status_conciliacao")
  sugestaoPedidoOperacionalId String?                    @map("sugestao_pedido_operacional_id")
  origemPedido                OrigemPedido               @map("origem_pedido")
  cliente                     Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itens                       ItemPedido[]
  pedidoOperacionalVinculo    PedidoOperacional?         @relation("PedidoOperacionalVinculo")
  eventosConciliacao          PedidoConciliacaoEvento[]

  @@index([clienteId, dataPedido])
  @@index([statusConciliacao])
  @@index([numeroVenda])
  @@index([sugestaoPedidoOperacionalId])
  @@map("pedidos")
}

model PedidoConciliacaoEvento {
  id                  String   @id @default(cuid())
  pedidoOperacionalId String?  @map("pedido_operacional_id")
  pedidoContaAzulId   String?  @map("pedido_conta_azul_id")
  tipo                String
  antes               Json?
  depois              Json?
  divergencias        Json?
  usuarioId           String?  @map("usuario_id")
  usuarioNome         String?  @map("usuario_nome")
  observacoes         String?  @db.Text
  criadoEm            DateTime @default(now()) @map("criado_em")

  pedidoOperacional PedidoOperacional? @relation(fields: [pedidoOperacionalId], references: [id], onDelete: SetNull)
  pedidoContaAzul   Pedido?            @relation(fields: [pedidoContaAzulId], references: [id], onDelete: SetNull)

  @@index([pedidoOperacionalId, criadoEm])
  @@index([pedidoContaAzulId, criadoEm])
  @@index([tipo, criadoEm])
  @@map("pedidos_conciliacao_eventos")
}

model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String   @map("pedido_id")
  sku        String?
  produto    String
  categoria  String?
  quantidade Decimal  @db.Decimal(12, 3)
  precoUnit  Decimal  @map("preco_unit") @db.Decimal(14, 2)
  custoUnit  Decimal? @map("custo_unit") @db.Decimal(14, 2)
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido")
}

model Interacao {
  id                    String        @id @default(cuid())
  clienteId             String        @map("cliente_id")
  tipoInteracao         TipoInteracao @map("tipo_interacao")
  dataInteracao         DateTime      @map("data_interacao")
  resumo                String?       @db.Text
  sentimento            Decimal?      @db.Decimal(4, 2)
  oportunidadeDetectada Boolean       @default(false) @map("oportunidade_detectada")
  riscoDetectado        Boolean       @default(false) @map("risco_detectado")
  conteudoBruto         String?       @map("conteudo_bruto") @db.LongText
  cliente               Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, dataInteracao])
  @@map("interacoes")
}

model Oportunidade {
  id                     String                 @id @default(cuid())
  clienteId              String                 @map("cliente_id")
  tipoOportunidade       TipoOportunidade       @map("tipo_oportunidade")
  descricao              String                 @db.Text
  valorEstimado          Decimal?               @map("valor_estimado") @db.Decimal(14, 2)
  probabilidadeConversao Decimal?               @map("probabilidade_conversao") @db.Decimal(5, 2)
  prioridade             PrioridadeOportunidade
  statusOportunidade     StatusOportunidade     @map("status_oportunidade")
  dataCriacao            DateTime               @default(now()) @map("data_criacao")
  dataFechamento         DateTime?              @map("data_fechamento")
  responsavelId          String?                @map("responsavel_id")

  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel Usuario? @relation(fields: [responsavelId], references: [id])

  @@index([prioridade, statusOportunidade])
  @@map("oportunidades")
}

model Mensagem {
  id                    String              @id @default(cuid())
  clienteId             String              @map("cliente_id")
  tipoMensagem          TipoMensagem        @map("tipo_mensagem")
  conteudoSugerido      String              @map("conteudo_sugerido") @db.Text
  conteudoFinal         String?             @map("conteudo_final") @db.Text
  statusEnvio           StatusEnvioMensagem @map("status_envio")
  sensivel              Boolean             @default(false)
  dataCriacao           DateTime            @default(now()) @map("data_criacao")
  dataAprovacao         DateTime?           @map("data_aprovacao")
  dataEnvio             DateTime?           @map("data_envio")
  aprovadorId           String?             @map("aprovador_id")
  canalEnvio            String              @default("MANYCHAT") @map("canal_envio")
  agendadoPara          DateTime?           @map("agendado_para")
  justificativaRejeicao String?             @map("justificativa_rejeicao") @db.Text

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  aprovador Usuario? @relation("MensagemAprovador", fields: [aprovadorId], references: [id])

  @@index([statusEnvio])
  @@map("mensagens")
}

model ExecucaoApi {
  id               String            @id @default(cuid())
  acaoApi          AcaoApi           @map("acao_api")
  dataExecucao     DateTime          @default(now()) @map("data_execucao")
  statusExecucao   StatusExecucaoApi @map("status_execucao")
  clienteId        String?           @map("cliente_id")
  detalhesExecucao Json              @map("detalhes_execucao")
  mensagemErro     String?           @map("mensagem_erro") @db.Text
  duracaoMs        Int?              @map("duracao_ms")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([acaoApi, dataExecucao])
  @@map("execucoes_api")
}

model KpiSnapshot {
  id             String     @id @default(cuid())
  nomeKpi        String     @map("nome_kpi")
  valor          Decimal    @db.Decimal(18, 4)
  periodo        PeriodoKpi
  dataReferencia DateTime   @map("data_referencia")
  payload        Json?

  @@unique([nomeKpi, periodo, dataReferencia])
  @@map("kpi_snapshots")
}

model IntegrationCredential {
  id           String    @id @default(cuid())
  provider     String    @unique
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at")
  metadata     Json?
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@map("integration_credentials")
}

model SyncState {
  id         String    @id @default(cuid())
  provider   String    @unique
  cursor     String?
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("sync_state")
}

model RegraClassificacao {
  id       String   @id @default(cuid())
  nome     String
  payload  Json
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("regras_classificacao")
}

model TemplateMensagem {
  id       String       @id @default(cuid())
  nome     String
  tipo     TipoMensagem
  corpo    String       @db.Text
  ativo    Boolean      @default(true)
  criadoEm DateTime     @default(now()) @map("criado_em")

  @@map("templates_mensagem")
}
