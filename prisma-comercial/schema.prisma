generator client {
  provider      = "prisma-client-js"
  output        = "../server/comercial/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("COMERCIAL_DATABASE_URL")
}

enum PerfilUsuario {
  GERENTE_COMERCIAL
  COMERCIAL
  OPERACOES
  ADMIN
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

enum TipoCliente {
  RESTAURANTE
  MERCADO
}

enum StatusRelacionamento {
  ATIVO
  INATIVO
  EM_RISCO
  ESTRATEGICO
}

enum OrigemPedido {
  CONTA_AZUL
  MANUAL
}

enum TipoInteracao {
  WHATSAPP
  EMAIL
  LIGACAO
  PRESENCIAL
}

enum TipoOportunidade {
  UPSELL
  CROSS_SELL
  REATIVACAO
  NOVO_PRODUTO
}

enum PrioridadeOportunidade {
  ALTA
  MEDIA
  BAIXA
}

enum StatusOportunidade {
  ABERTA
  EM_CONTATO
  CONVERTIDA
  PERDIDA
}

enum TipoMensagem {
  POS_VENDA
  OFERTA
  REATIVACAO
  INFORMATIVO
}

enum StatusEnvioMensagem {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  ENVIADA
  FALHA
}

enum AcaoApi {
  SYNC_CA
  ENVIO_MC
  ANALISE_IG
  PESQUISA_WEB
}

enum StatusExecucaoApi {
  SUCESSO
  FALHA
  PENDENTE
}

enum PeriodoKpi {
  DIARIO
  SEMANAL
  MENSAL
}

model Usuario {
  id            String        @id @default(cuid())
  nome          String
  email         String        @unique
  senhaHash     String        @map("senha_hash")
  perfil        PerfilUsuario
  status        StatusUsuario @default(ATIVO)
  dataCadastro  DateTime      @default(now()) @map("data_cadastro")
  mensagens     Mensagem[]    @relation("MensagemAprovador")
  refreshTokens RefreshToken[]
  oportunidades Oportunidade[]

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String    @map("usuario_id")
  tokenHash  String    @map("token_hash")
  expiresEm  DateTime  @map("expires_em")
  revogadoEm DateTime? @map("revogado_em")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Cliente {
  id                     String                @id @default(cuid())
  externalId             String?               @unique @map("external_id")
  nome                   String
  tipo                   TipoCliente
  cnpjCpf                String?               @map("cnpj_cpf")
  endereco               String?
  contatoPrincipal       String?               @map("contato_principal")
  emailPrincipal         String?               @map("email_principal")
  telefoneWhatsapp       String?               @map("telefone_whatsapp")
  scoreComercial         Decimal?              @map("score_comercial") @db.Decimal(5, 2)
  statusRelacionamento   StatusRelacionamento  @map("status_relacionamento")
  tags                   Json
  urlInstagram           String?               @map("url_instagram")
  urlSite                String?               @map("url_site")
  dataCadastro           DateTime              @default(now()) @map("data_cadastro")
  dataUltimaAtualizacao  DateTime              @updatedAt @map("data_ultima_atualizacao")

  pedidos      Pedido[]
  interacoes   Interacao[]
  oportunidades Oportunidade[]
  mensagens    Mensagem[]
  execucoes    ExecucaoApi[]

  @@index([tipo, statusRelacionamento])
  @@index([nome])
  @@map("clientes")
}

model Pedido {
  id            String       @id @default(cuid())
  externalId    String?      @unique @map("external_id")
  clienteId     String       @map("cliente_id")
  dataPedido    DateTime     @map("data_pedido")
  valorTotal    Decimal      @map("valor_total") @db.Decimal(14, 2)
  valorBruto    Decimal?     @map("valor_bruto") @db.Decimal(14, 2)
  valorFrete    Decimal      @default(0) @map("valor_frete") @db.Decimal(14, 2)
  valorDesconto Decimal      @default(0) @map("valor_desconto") @db.Decimal(14, 2)
  valorLiquido  Decimal?     @map("valor_liquido") @db.Decimal(14, 2)
  statusPedido  String       @map("status_pedido")
  origemPedido  OrigemPedido @map("origem_pedido")
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itens        ItemPedido[]

  @@index([clienteId, dataPedido])
  @@map("pedidos")
}

model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String   @map("pedido_id")
  sku        String?
  produto    String
  categoria  String?
  quantidade Decimal  @db.Decimal(12, 3)
  precoUnit  Decimal  @map("preco_unit") @db.Decimal(14, 2)
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido")
}

model Interacao {
  id                  String        @id @default(cuid())
  clienteId           String        @map("cliente_id")
  tipoInteracao       TipoInteracao @map("tipo_interacao")
  dataInteracao       DateTime      @map("data_interacao")
  resumo              String?       @db.Text
  sentimento          Decimal?      @db.Decimal(4, 2)
  oportunidadeDetectada Boolean     @default(false) @map("oportunidade_detectada")
  riscoDetectado      Boolean       @default(false) @map("risco_detectado")
  conteudoBruto       String?       @map("conteudo_bruto") @db.LongText
  cliente             Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, dataInteracao])
  @@map("interacoes")
}

model Oportunidade {
  id                    String                  @id @default(cuid())
  clienteId             String                  @map("cliente_id")
  tipoOportunidade      TipoOportunidade        @map("tipo_oportunidade")
  descricao             String                  @db.Text
  valorEstimado         Decimal?                @map("valor_estimado") @db.Decimal(14, 2)
  probabilidadeConversao Decimal?               @map("probabilidade_conversao") @db.Decimal(5, 2)
  prioridade            PrioridadeOportunidade
  statusOportunidade    StatusOportunidade      @map("status_oportunidade")
  dataCriacao           DateTime                @default(now()) @map("data_criacao")
  dataFechamento        DateTime?               @map("data_fechamento")
  responsavelId         String?                 @map("responsavel_id")

  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel   Usuario?  @relation(fields: [responsavelId], references: [id])

  @@index([prioridade, statusOportunidade])
  @@map("oportunidades")
}

model Mensagem {
  id               String               @id @default(cuid())
  clienteId        String               @map("cliente_id")
  tipoMensagem     TipoMensagem         @map("tipo_mensagem")
  conteudoSugerido String               @map("conteudo_sugerido") @db.Text
  conteudoFinal    String?              @map("conteudo_final") @db.Text
  statusEnvio      StatusEnvioMensagem  @map("status_envio")
  sensivel         Boolean              @default(false)
  dataCriacao      DateTime             @default(now()) @map("data_criacao")
  dataAprovacao    DateTime?            @map("data_aprovacao")
  dataEnvio        DateTime?            @map("data_envio")
  aprovadorId      String?              @map("aprovador_id")
  canalEnvio       String               @default("MANYCHAT") @map("canal_envio")
  agendadoPara     DateTime?            @map("agendado_para")
  justificativaRejeicao String?         @map("justificativa_rejeicao") @db.Text

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  aprovador Usuario? @relation("MensagemAprovador", fields: [aprovadorId], references: [id])

  @@index([statusEnvio])
  @@map("mensagens")
}

model ExecucaoApi {
  id              String            @id @default(cuid())
  acaoApi         AcaoApi           @map("acao_api")
  dataExecucao    DateTime          @default(now()) @map("data_execucao")
  statusExecucao  StatusExecucaoApi @map("status_execucao")
  clienteId       String?           @map("cliente_id")
  detalhesExecucao Json             @map("detalhes_execucao")
  mensagemErro    String?           @map("mensagem_erro") @db.Text
  duracaoMs       Int?              @map("duracao_ms")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([acaoApi, dataExecucao])
  @@map("execucoes_api")
}

model KpiSnapshot {
  id            String     @id @default(cuid())
  nomeKpi       String     @map("nome_kpi")
  valor         Decimal    @db.Decimal(18, 4)
  periodo       PeriodoKpi
  dataReferencia DateTime  @map("data_referencia")
  payload       Json?

  @@unique([nomeKpi, periodo, dataReferencia])
  @@map("kpi_snapshots")
}

model IntegrationCredential {
  id           String   @id @default(cuid())
  provider     String   @unique
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at")
  metadata     Json?
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("integration_credentials")
}

model SyncState {
  id         String   @id @default(cuid())
  provider   String   @unique
  cursor     String?
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("sync_state")
}

model RegraClassificacao {
  id        String   @id @default(cuid())
  nome      String
  payload   Json
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("regras_classificacao")
}

model TemplateMensagem {
  id        String       @id @default(cuid())
  nome      String
  tipo      TipoMensagem
  corpo     String       @db.Text
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  @@map("templates_mensagem")
}
